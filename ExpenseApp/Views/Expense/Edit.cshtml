@model ExpenseApp.Models.Expense

<h1>支出編集</h1>

<form method="post">
    <input type="hidden" asp-for="Id">

    <div>
        <label>日付</label>
        <input asp-for="Date" type="date">
    </div>
    <div>
        <label>金額</label>
        <input asp-for="Amount">
    </div>

    <div>
        <label>カテゴリ</label>
        <input asp-for="Category">
    </div>

    <div>
        <label>メモ</label>
        <input asp-for="Memo">
    </div>

    <button type="submit">更新</button>
</form>